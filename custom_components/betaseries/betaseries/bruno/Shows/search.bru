meta {
  name: search
  type: http
  seq: 8
  tags: [
    Shows
  ]
}

get {
  url: {{baseUrl}}/shows/search?title=silo&locale=fr
  body: none
  auth: inherit
}

params:query {
  @description('Searched title')
  title: silo
  @description('Locale parameter to specify language preference')
  locale: fr
  @description('Return only essential series info')
  ~summary: false
  @description('Return order (title|popularity|followers), default title')
  ~order: null
  @description('Only series from the last two years')
  ~recent: false
  @description('IDs of SVOD/VOD platforms where series are available')
  ~platforms: null
  @description('Country for SVOD/VOD platforms')
  ~country: null
  @description('Number of results per page, default 5, maximum 100')
  ~nbpp: null
  @description('Page number, default 1')
  ~page: null
}

headers {
  X-BetaSeries-Key: {{apiKey}}
  X-BetaSeries-Version: 3.0
  Authorization: Bearer {{token}}
}

settings {
  encodeUrl: true
  timeout: 0
  followRedirects: true
  maxRedirects: 5
}

docs {
  Search for a series, with member information if a token is provided.
}

example {
  name: example

  request: {
    url: {{baseUrl}}/shows/search?title=silo&locale=fr
    method: GET
    mode: none
    params:query: {
      title: silo
      locale: fr
      ~summary: false
      ~order: null
      ~recent: false
      ~platforms: null
      ~country: null
      ~nbpp: null
      ~page: null
    }

    headers: {
      X-BetaSeries-Key: {{apiKey}}
      X-BetaSeries-Version: 3.0
      Authorization: Bearer {{token}}
    }
  }

  response: {
    headers: {
      content-type: application/json
