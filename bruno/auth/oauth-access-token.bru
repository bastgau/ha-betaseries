meta {
  name: 2 - OAuth Access Token (poll)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/oauth/access_token
  body: formUrlEncoded
  auth: none
}

headers {
  X-BetaSeries-Key: {{apiKey}}
  X-BetaSeries-Version: 3.0
}

body:form-urlencoded {
  client_id: {{apiKey}}
  client_secret: {{clientSecret}}
  code: {{deviceCode}}
}

vars:pre-request {
  apiKey:
  baseUrl: https://api.betaseries.com
  clientSecret:
  deviceCode:
}

script:post-response {
  // Token may come back as `access_token=xxxx` (urlencoded) OR as JSON — handle both
  const body = res.getBody();
  let token;
  if (typeof body === "string") {
    const m = body.match(/access_token=([^&\s]+)/);
    if (m) token = m[1];
  } else if (body && body.access_token) {
    token = body.access_token;
  }
  if (token) bru.setEnvVar("token", token);
}

docs {
  VERIFY #6: run BEFORE validating the code -> what does "pending" look like? (HTTP status? errors[]?)
  Run again AFTER validating -> should return the token.
}
