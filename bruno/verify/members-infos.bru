meta {
  name: members-infos (schema + stats units)
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/members/infos
  body: none
  auth: none
}

params:query {
  ~summary: true
}

headers {
  X-BetaSeries-Key: {{apiKey}}
  X-BetaSeries-Version: 3.0
  Authorization: Bearer {{token}}
}

vars:pre-request {
  token:
  apiKey:
  baseUrl: https://api.betaseries.com
}

docs {
  VERIFY #5: which stats fields exist in v3.0 by default vs behind summary=true.
  VERIFY units of time_to_spend / time_on_tv (minutes? seconds?) for device_class duration.
  Defaults to the identified member (no id needed).
}
