meta {
  name: notifications
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/members/notifications?all=true&sort=DESC
  body: none
  auth: none
}

params:query {
  all: true
  sort: DESC
}

headers {
  X-BetaSeries-Key: {{apiKey}}
  X-BetaSeries-Version: 3.0
  Authorization: Bearer {{token}}
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Displays the latest member notifications. Types: badge, banner, bugs, character, comment, donations, episode, facebook, film, forum, friend, message, quiz, recommend, site, subtitles, video.
}

