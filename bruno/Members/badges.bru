meta {
  name: badges
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/members/badges?id={{userId}}
  body: none
  auth: none
}

params:query {
  id: {{userId}}
}

headers {
  X-BetaSeries-Key: {{apiKey}}
  X-BetaSeries-Version: 3.0
  ~Authorization: Bearer {{token}}
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Displays member badges.
}

