meta {
  name: note
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/shows/note
  body: formUrlEncoded
  auth: none
}

headers {
  X-BetaSeries-Key: {{apiKey}}
  X-BetaSeries-Version: 3.0
  Authorization: Bearer {{token}}
}

body:form-urlencoded {
  id: {{showId}}
  note: 4
}

docs {
  Rate a season.
}
