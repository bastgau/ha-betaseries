meta {
  name: list
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/shows/list
  body: none
  auth: none
}

params:query {
  ~fields: id
}

headers {
  X-BetaSeries-Key: {{apiKey}}
  X-BetaSeries-Version: 3.0
  Authorization: Bearer {{token}}
}

docs {
  Display the list of all series.
}

example {
  name: example

  request: {
    url: {{baseUrl}}/shows/episodes?id=6946&locale=en
    method: GET
    mode: none
    params:query: {
      id: 6946
      locale: en
    }

    headers: {
      X-BetaSeries-Key: {{apiKey}}
      X-BetaSeries-Version: 3.0
      Authorization: Bearer {{token}}
    }
  }

  response: {
    headers: {
      content-type: application/json
      cache-control: no-cache, private
      access-control-allow-origin: *
      access-control-allow-headers: Content-Type,Origin,X-BetaSeries-Token,X-BetaSeries-Key,X-BetaSeries-Version,Authorization
      access-control-allow-methods: GET,POST,PUT,DELETE,OPTIONS
    }

