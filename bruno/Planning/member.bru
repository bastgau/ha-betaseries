  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/planning/member?month=2026-07
  body: none
  auth: none
}

params:query {
  month: 2026-07
}

headers {
  X-BetaSeries-Key: {{apiKey}}
  X-BetaSeries-Version: 3.0
  Authorization: Bearer {{token}}
}

vars:pre-request {
  month: 2026-08
}

docs {
  Display the schedule of the identified member or another member.
}

