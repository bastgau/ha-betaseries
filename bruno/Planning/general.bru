meta {
  name: general
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/planning/general?before=0&after=2
  body: none
  auth: none
}

params:query {
  before: 0
  after: 2
}

headers {
  X-BetaSeries-Key: {{apiKey}}
  X-BetaSeries-Version: 3.0
  Authorization: Bearer {{token}}
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Display all episodes broadcasted in the last 8 days and up to the next 8 days.
}

