meta {
  name: 1 - Watched
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/seasons/watched
  body: formUrlEncoded
  auth: none
}

headers {
  X-BetaSeries-Key: {{apiKey}}
  X-BetaSeries-Version: 3.0
  Authorization: Bearer {{token}}
}

body:form-urlencoded {
  id: {{showId}}
  season: {{seasonNumber}}
}

docs {
  Mark all episodes of a season as watched. Skips already watched episodes.
}
