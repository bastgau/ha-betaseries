meta {
  name: badges
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/badges/badge?id=1,64
  body: none
  auth: none
}

params:query {
  id: 1,64
}

headers {
  X-BetaSeries-Key: {{apiKey}}
  X-BetaSeries-Version: 3.0
  Authorization: Bearer {{token}}
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Returns a badge details.
}

example {
  name: example
  
  request: {
    url: {{baseUrl}}/badges/badge?id=1,64
    method: GET
    mode: none
    params:query: {
      id: 1,64
    }
  
    headers: {
      X-BetaSeries-Key: {{apiKey}}
      X-BetaSeries-Version: 3.0
      Authorization: Bearer {{token}}
    }
  }
  
  response: {
    headers: {
      content-type: application/json
      cache-control: no-cache, private
      access-control-allow-origin: *
      access-control-allow-headers: Content-Type,Origin,X-BetaSeries-Token,X-BetaSeries-Key,X-BetaSeries-Version,Authorization
      access-control-allow-methods: GET,POST,PUT,DELETE,OPTIONS
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "badges": [
            {
              "id": 1,
              "name": "Débutant",
              "description": "Vous avez regardé votre premier épisode. Bienvenue sur BetaSeries !",
              "picture_url": "https://www.betaseries.com/images/badges/debutant.png",
              "width": 256,
              "height": 256,
              "level": null
            },
            {
              "id": 64,
              "name": "Regarde-moi",
              "description": "Un mois s'est écoulé et 30 épisodes ont été regardés, vous avez le double-clic facile.",
              "picture_url": "https://www.betaseries.com/images/badges/regarde_moi.png",
              "width": 256,
              "height": 256,
              "level": null
            }
          ],
          "errors": []
        }
      '''
    }
  }
}
