meta {
  name: oauth-access-token
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/oauth/access_token
  body: formUrlEncoded
  auth: none
}

headers {
  X-BetaSeries-Key: {{apiKey}}
  X-BetaSeries-Version: 3.0
}

body:form-urlencoded {
  client_id: {{apiKey}}
  client_secret: {{clientSecret}}
  code: {{deviceCode}}
}

script:post-response {
  // Token may come back as `access_token=xxxx` (urlencoded) OR as JSON - handle both
  const body = res.getBody();
  let token;
  if (typeof body === "string") {
    const m = body.match(/access_token=([^&\s]+)/);
    if (m) token = m[1];
  } else if (body && body.access_token) {
    token = body.access_token;
  }
  if (token) bru.setEnvVar("token", token);
}

docs {
  Retrieves an access token with the code provided by OAuth 2 authentication.
}

example {
  name: example [400]
  
  request: {
    url: {{baseUrl}}/oauth/access_token
    method: POST
    mode: formUrlEncoded
    headers: {
      X-BetaSeries-Key: {{apiKey}}
      X-BetaSeries-Version: 3.0
    }
  
    body:form-urlencoded: {
      client_id: {{apiKey}}
      client_secret: {{clientSecret}}
      code: {{deviceCode}}
    }
  }
  
  response: {
    headers: {
      content-type: application/json
      cache-control: no-cache, private
      access-control-allow-origin: *
      access-control-allow-headers: Content-Type,Origin,X-BetaSeries-Token,X-BetaSeries-Key,X-BetaSeries-Version,Authorization
      access-control-allow-methods: GET,POST,PUT,DELETE,OPTIONS
    }
  
    status: {
      code: 400
      text: Bad Request
    }
  
    body: {
      type: json
      content: '''
        {
          "errors": [
            {
              "code": 2001,
              "text": "En attente de l'identification."
            }
          ]
        }
      '''
    }
  }
}

example {
  name: example [200]
  
  request: {
    url: {{baseUrl}}/oauth/access_token
    method: POST
    mode: formUrlEncoded
    headers: {
      X-BetaSeries-Key: {{apiKey}}
      X-BetaSeries-Version: 3.0
    }
  
    body:form-urlencoded: {
      client_id: {{apiKey}}
      client_secret: {{clientSecret}}
      code: {{deviceCode}}
    }
  }
  
  response: {
    headers: {
      content-type: application/json
      cache-control: no-store, private
      access-control-allow-origin: *
      access-control-allow-headers: Content-Type,Origin,X-BetaSeries-Token,X-BetaSeries-Key,X-BetaSeries-Version,Authorization
      access-control-allow-methods: GET,POST,PUT,DELETE,OPTIONS
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "access_token": "xxxxxx",
          "token_type": "bearer"
        }
      '''
    }
  }
}
