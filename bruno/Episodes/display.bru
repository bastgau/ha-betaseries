meta {
  name: display
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/episodes/display?id=38605,38606
  body: none
  auth: none
}

params:query {
  id: 38605,38606
}

headers {
  X-BetaSeries-Key: {{apiKey}}
  X-BetaSeries-Version: 3.0
  Authorization: Bearer {{token}}
}

docs {
  Fetch the list of episodes to watch, with various filters and pagination options.
}

