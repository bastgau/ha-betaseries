meta {
  name: list
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/episodes/list?showsLimit=1&limit=1&excludes=characters
  body: none
  auth: none
}

params:query {
  showsLimit: 1
  limit: 1
  excludes: characters
}

headers {
  X-BetaSeries-Key: {{apiKey}}
  X-BetaSeries-Version: 3.0
  Authorization: Bearer {{token}}
}

docs {
  Fetch the list of episodes to watch, with various filters and pagination options.
}

example {
  name: example

  request: {
    url: {{baseUrl}}/episodes/list?showsLimit=10&limit=2&excludes=characters
    method: GET
    mode: none
    params:query: {
      showsLimit: 10
      limit: 2
      excludes: characters
    }

    headers: {
      X-BetaSeries-Key: {{apiKey}}
      X-BetaSeries-Version: 3.0
      Authorization: Bearer {{token}}
    }
  }

  response: {
    headers: {
      content-type: application/json
      cache-control: no-cache, private
      access-control-allow-origin: *
      access-control-allow-headers: Content-Type,Origin,X-BetaSeries-Token,X-BetaSeries-Key,X-BetaSeries-Version,Authorization
      access-control-allow-methods: GET,POST,PUT,DELETE,OPTIONS
    }

    status: {
      code: 200
      text: OK
    }

