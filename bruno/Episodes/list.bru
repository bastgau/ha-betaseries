meta {
  name: list
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/episodes/list?showsLimit=1&limit=1
  body: none
  auth: none
}

params:query {
  showsLimit: 1
  limit: 1
}

headers {
  X-BetaSeries-Key: {{apiKey}}
  X-BetaSeries-Version: 3.0
  Authorization: Bearer {{token}}
}

docs {
  Fetch the list of episodes to watch, with various filters and pagination options.
}

example {
  name: example
  
  request: {
    url: {{baseUrl}}/episodes/list?showsLimit=1&limit=1
    method: GET
    mode: none
    params:query: {
      showsLimit: 1
      limit: 1
    }
  
