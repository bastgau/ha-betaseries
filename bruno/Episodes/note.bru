meta {
  name: note
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/episodes/note
  body: formUrlEncoded
  auth: none
}

headers {
  X-BetaSeries-Key: {{apiKey}}
  X-BetaSeries-Version: 3.0
  Authorization: Bearer {{token}}
}

body:form-urlencoded {
  id: {{episodeId}}
  note: 4
}

docs {
  Rate an episode with a score from 1 to 5.
}
