meta {
  name: 1 - List
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/episodes/list?showsLimit=3&limit=2
  body: none
  auth: none
}

params:query {
  showsLimit: 3
  limit: 2
}

headers {
  X-BetaSeries-Key: {{apiKey}}
  X-BetaSeries-Version: 3.0
  Authorization: Bearer {{token}}
}

docs {
  Fetch the list of episodes to watch, with various filters and pagination options.
}

example {
  name: example
  
  request: {
    url: {{baseUrl}}/episodes/list?showsLimit=3&limit=2
    method: GET
    mode: none
    params:query: {
      showsLimit: 3
      limit: 2
    }
  
    headers: {
      X-BetaSeries-Key: {{apiKey}}
      X-BetaSeries-Version: 3.0
      Authorization: Bearer {{token}}
    }
  }
  
  response: {
    headers: {
      content-type: application/json
      cache-control: no-cache, private
      access-control-allow-origin: *
      access-control-allow-headers: Content-Type,Origin,X-BetaSeries-Token,X-BetaSeries-Key,X-BetaSeries-Version,Authorization
      access-control-allow-methods: GET,POST,PUT,DELETE,OPTIONS
    }
  
