meta {
  name: member
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/timeline/member?id={{userId}}&nbpp=100
  body: none
  auth: none
}

params:query {
  id: {{userId}}
  nbpp: 100
  ~since_id: 
  ~last_id: 
  ~types: 
}

headers {
  X-BetaSeries-Key: {{apiKey}}
  X-BetaSeries-Version: 3.0
  Authorization: Bearer {{token}}
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Displays the latest events of the specified member.
}

example {
  name: example
  
  request: {
    url: {{baseUrl}}/timeline/member?id={{userId}}&nbpp=100
    method: GET
    mode: none
    params:query: {
      id: {{userId}}
      nbpp: 100
      ~since_id: 
      ~last_id: 
      ~types: 
    }
  
    headers: {
      X-BetaSeries-Key: {{apiKey}}
      X-BetaSeries-Version: 3.0
      Authorization: Bearer {{token}}
    }
  }
  
  response: {
    headers: {
      content-type: application/json
      cache-control: no-cache, private
      access-control-allow-origin: *
      access-control-allow-headers: Content-Type,Origin,X-BetaSeries-Token,X-BetaSeries-Key,X-BetaSeries-Version,Authorization
      access-control-allow-methods: GET,POST,PUT,DELETE,OPTIONS
    }
  
    status: {
      code: 200
      text: OK
    }
  
